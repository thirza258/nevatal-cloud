# Nevatal Cloud web control plane - nginx server configuration TEMPLATE.
#
# The nginx image entrypoint renders this file with envsubst into
# /etc/nginx/conf.d/default.conf at container start. Only the variables listed
# in NGINX_ENVSUBST_FILTER (see frontend/Dockerfile) are substituted:
#
#   ${BACKEND_UPSTREAM}            API address, e.g. backend:8090
#   ${NGINX_LOCAL_RESOLVERS}       DNS servers from /etc/resolv.conf (entrypoint)
#   ${NGINX_CLIENT_MAX_BODY_SIZE}  upload limit for /api (default 2g)
#   ${NGINX_ISO_MAX_BODY_SIZE}     upload limit for the admin ISO route (default 8g)
#
# Every other $name below is an nginx runtime variable and is left untouched.
# This file is included inside the http {} block of /etc/nginx/nginx.conf.

# --------------------------------------------------------------------------
# API upstream: load balancing across every backend replica.
#
# "resolve" (open-source nginx >= 1.27.3) re-resolves BACKEND_UPSTREAM every
# 5s, so `docker compose up --scale backend=N` or a Kubernetes headless
# Service adds/removes replicas without reloading nginx. A replica that fails
# 3 times is taken out for 10s; failed connects are retried on the next one.
# --------------------------------------------------------------------------
resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;
resolver_timeout 5s;

upstream nevatal_api {
    zone nevatal_api 64k;
    # The balancing method must come before "keepalive".
    least_conn;
    server ${BACKEND_UPSTREAM} resolve max_fails=3 fail_timeout=10s;
    keepalive 32;
    keepalive_timeout 60s;
}

# WebSocket upgrade when requested, otherwise an empty Connection header so
# upstream keepalive connections are reused.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# Preserve the scheme seen by an outer TLS terminator; fall back to ours.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 8080 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    server_tokens off;
    # Relative redirects: the container port (8080) is never the public one.
    absolute_redirect off;

    # Object-storage uploads go through /api; the default nginx limit (1m)
    # would reject them with 413.
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    client_body_timeout 300s;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # Liveness/readiness of nginx itself (no backend dependency): used by the
    # image HEALTHCHECK and Kubernetes probes.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        return 200 "ok\n";
    }

    # Backend API reverse proxy (REST, WebSocket upgrade, streaming)
    location /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Admin ISO uploads can be several GB.
    location = /api/v1/admin/isos/upload {
        client_max_body_size ${NGINX_ISO_MAX_BODY_SIZE};
        client_body_timeout 600s;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Health check passthrough (load balancers probe this: nginx + API)
    location = /health {
        access_log off;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Static assets with cache-busting hashes in filename
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Agent readiness and discovery (.well-known)
    location ^~ /.well-known/ {
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "public, max-age=3600";
        include /etc/nginx/snippets/security-headers.conf;
        default_type application/json;
        try_files $uri =404;
    }

    # Static files like favicon, robots.txt, sitemap.xml, llms.txt
    location ~* \.(?:txt|xml)$ {
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "public, max-age=3600";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Static media files
    location ~* \.(?:ico|png|svg|jpg|jpeg|gif|webp|woff|woff2|ttf|eot)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Root index.html - NEVER cache so clients always get fresh script/style hashes
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # SPA route fallback
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
