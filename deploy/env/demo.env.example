# =============================================================================
# Nevatal Cloud - DEMO deployment
#
#   cp deploy/env/demo.env.example .env
#   # set JWT_SECRET and POSTGRES_PASSWORD (openssl rand -hex 32), DOMAIN/APP_BASE_URL
#   ./deploy.sh --mode demo
#
# Demo mode is a public showcase:
#   * seeds PUBLIC demo accounts: admin@nevatal.id / AdminPass123! and
#     demo@nevatal.id / DemoPass123!, shown as quick logins in the UI
#   * always uses the SIMULATED hypervisor (PROXMOX_MOCK is forced to true);
#     it never touches Proxmox, so no Proxmox credentials belong here
#   * runs exactly ONE backend replica (the simulator lives in process memory)
# Anyone can log in as admin. Reset it nightly: ./deploy.sh --reset-demo --yes
#
# Values: use hex secrets only (openssl rand -hex 32). Docker Compose
# interpolates "$" in this file, so never use "$" in a value.
# Lines containing CHANGE_ME make ./deploy.sh refuse to deploy.
# =============================================================================

# --- Mode wiring (keep these together) -----------------------------------------
NEVATAL_MODE=demo
# Plain `docker compose ps|logs|exec` from the repo root use the same files.
COMPOSE_FILE=docker-compose.yml:deploy/compose/demo.yml
# Separate project name = separate volumes: a demo database can never be
# picked up by a production deployment on the same VM.
COMPOSE_PROJECT_NAME=nevatal-demo
# Optional services (comma-separated):
#   tls     Caddy: automatic HTTPS for DOMAIN (needs inbound 80/443 + DNS record)
#   tunnel  cloudflared: Cloudflare Tunnel, no inbound ports (CLOUDFLARE_TUNNEL_TOKEN)
# The "edge" profile (subdomains) is production-only and refused in demo mode.
# Leave commented when TLS is terminated elsewhere (HAProxy, a tunnel in another LXC).
# COMPOSE_PROFILES=tls

# --- Mode flags ---------------------------------------------------------------------
# deploy/compose/demo.yml forces these; repeated here so even a compose run
# without the override (e.g. `docker compose -f docker-compose.yml ...`)
# stays in demo mode.
APP_ENV=production
DEMO_MODE=true
PROXMOX_MOCK=true

# --- Public URL -------------------------------------------------------------------
# Hostname served by Caddy (profile tls) and used in APP_BASE_URL.
DOMAIN=demo.nevatal.id
# Must be the URL users type in the browser (https:// => Secure cookies).
APP_BASE_URL=https://demo.nevatal.id
# Comma-separated; empty = origin of APP_BASE_URL.
CORS_ALLOWED_ORIGINS=
# Comma-separated CIDRs allowed to set X-Forwarded-For; empty = private ranges + loopback.
TRUSTED_PROXIES=
TZ=UTC

# --- Web entry point -------------------------------------------------------------
# nginx (frontend) is published on HTTP_BIND:HTTP_PORT.
# With COMPOSE_PROFILES=tls or tunnel set HTTP_BIND=127.0.0.1 so only Caddy /
# the tunnel is public.
HTTP_BIND=0.0.0.0
HTTP_PORT=3080
# Must stay 1 in demo mode.
BACKEND_REPLICAS=1

# --- Cloudflare Tunnel (profile tunnel) ------------------------------------------------
# Token of a remotely-managed tunnel with one public hostname:
#   demo.nevatal.id -> http://frontend:8080
# Required when COMPOSE_PROFILES contains "tunnel" (docs/PROXMOX_INSTALL.md section 20).
CLOUDFLARE_TUNNEL_TOKEN=
# Optional: CLOUDFLARED_METRICS_PORT=20241 (host loopback), CLOUDFLARED_VERSION=2026.10.7

# --- Subdomains (always OFF in demo mode) ---------------------------------------------
# Must stay EMPTY: deploy/compose/demo.yml forces it empty and the API turns
# the feature off in demo mode anyway. Railway-style subdomains are a
# production feature (deploy/env/production.env.example).
PUBLIC_DOMAIN_ROOT=
# AdControl injection is a production edge feature; leave it empty in demo.
ADCONTROL_SITE_KEY=

# --- Secrets ------------------------------------------------------------------------
# openssl rand -hex 32   (>= 32 characters, required)
JWT_SECRET=CHANGE_ME
# openssl rand -hex 32   (only applied when the database volume is first created)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=nevatal
POSTGRES_DB=nevatal_cloud

# --- Optional integrations ------------------------------------------------------------
# OpenRouter key for the AI assistant (empty = local fallback mode). Visitors
# of a public demo can spend this key's credit: use a capped key or leave empty.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# WordPress bridge: empty = disabled.
WORDPRESS_API_KEY=
WORDPRESS_URL=

# --- Not needed in demo mode ---------------------------------------------------------
# Listed for completeness (same contract as production). Leave them commented.
# Empty COOKIE_SECURE = true when APP_BASE_URL starts with https://
# COOKIE_SECURE=
# Per-replica PostgreSQL pool (backend defaults 15 / 5)
# DB_MAX_OPEN_CONNS=
# DB_MAX_IDLE_CONNS=
# AI orchestrator Phases 2–4 (empty = code default; docs/ORCHESTRATOR.md 4.10)
# MONITOR_INTERVAL_SECONDS=30
# ORCH_DB_BACKUP_INTERVAL_SECONDS=86400
# ORCH_NOTIFICATION_RETENTION_DAYS=30
# ORCH_COST_CURRENCY=USD
# ORCH_COST_VCPU_MONTH=5
# ORCH_COST_MEMORY_GB_MONTH=2.5
# ORCH_COST_DISK_GB_MONTH=0.1
# ORCH_COST_BUCKET_GB_MONTH=0.02
# Setting ADMIN_* in demo mode creates an ADDITIONAL admin next to the public
# demo admin; the demo accounts stay public either way.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Ignored: demo mode always uses the simulated hypervisor. Never put a real
# Proxmox token on a public demo host.
# PROXMOX_HOST=
# PROXMOX_PORT=8006
# PROXMOX_TOKEN_ID=
# PROXMOX_TOKEN_SECRET=
# PROXMOX_NODE_NAME=pve-dell-r640
# PROXMOX_STORAGE=local-zfs
# PROXMOX_VERIFY_TLS=false
# Subdomain settings: ignored, the feature is off in demo mode.
# RESERVED_SUBDOMAINS=
# MAX_DOMAINS_PER_USER=5
# DOMAIN_QUARANTINE_DAYS=14
# EDGE_TARGET_CIDRS=
# EDGE_DENY_IPS=
# Social login is mocked in demo mode; real OAuth apps are not needed.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Images ---------------------------------------------------------------------------
# Built locally by ./deploy.sh. To run prebuilt images instead, set these and
# run ./deploy.sh --no-build after `docker compose pull backend frontend`.
# BACKEND_IMAGE=ghcr.io/thirza258/nevatal-cloud-backend
# FRONTEND_IMAGE=ghcr.io/thirza258/nevatal-cloud-frontend
# IMAGE_TAG=latest
