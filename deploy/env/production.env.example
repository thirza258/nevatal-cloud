# =============================================================================
# Nevatal Cloud - PRODUCTION deployment (real Proxmox VE hypervisor)
#
#   cp deploy/env/production.env.example .env
#   chmod 600 .env
#   # replace every CHANGE_ME (see docs/PROXMOX_INSTALL.md)
#   ./deploy.sh --mode production
#
# The API refuses to start in production when JWT_SECRET is weak, ADMIN_* is
# missing, or PROXMOX_MOCK=false without complete Proxmox settings.
# ./deploy.sh checks the same rules before deploying.
#
# Values: use hex secrets only (openssl rand -hex 32). Docker Compose
# interpolates "$" in this file, so never use "$" in a value.
# Lines containing CHANGE_ME make ./deploy.sh refuse to deploy.
# =============================================================================

# --- Mode wiring (keep these together) -----------------------------------------
NEVATAL_MODE=production
# Plain `docker compose ps|logs|exec` from the repo root use the same files.
# Topology B (several app VMs, external DB + NFS) appends:
#   :deploy/compose/multi-vm.yml
# A cloudflared/proxy OUTSIDE this stack that must reach the edge appends:
#   :deploy/compose/edge-publish.yml
COMPOSE_FILE=docker-compose.yml:deploy/compose/production.yml
# Separate project name = separate volumes (never reuse a demo database).
COMPOSE_PROJECT_NAME=nevatal-prod
# Optional services (comma-separated):
#   tls     Caddy: automatic HTTPS for DOMAIN (needs inbound 80/443 + DNS record)
#   tunnel  cloudflared: Cloudflare Tunnel, no inbound ports (CLOUDFLARE_TUNNEL_TOKEN)
#   edge    subdomain edge proxy for https://<name>.PUBLIC_DOMAIN_ROOT
# Home lab / colo without a public IP:   COMPOSE_PROFILES=tunnel  (+ edge)
# Public IP with ports 80/443 forwarded: COMPOSE_PROFILES=tls
# Neither: TLS is terminated elsewhere (HAProxy, an existing reverse proxy);
# point that proxy at HTTP_BIND:HTTP_PORT.
# COMPOSE_PROFILES=edge,tunnel

# --- Mode flags ---------------------------------------------------------------------
# deploy/compose/production.yml forces these; repeated here so even a compose
# run without the override (e.g. `docker compose -f docker-compose.yml ...`)
# never starts with public demo accounts.
APP_ENV=production
DEMO_MODE=false

# --- Public URL -------------------------------------------------------------------
DOMAIN=cloud.nevatal.id
# Must be the URL users type in the browser (https:// => Secure cookies).
APP_BASE_URL=https://cloud.nevatal.id
# Comma-separated explicit origins; empty = origin of APP_BASE_URL. "*" is rejected.
CORS_ALLOWED_ORIGINS=
# Comma-separated CIDRs allowed to set X-Forwarded-For. Empty = private ranges
# + loopback. Narrow it to your proxy/LB addresses when clients share the LAN.
TRUSTED_PROXIES=
# Empty = true when APP_BASE_URL starts with https://
COOKIE_SECURE=
TZ=UTC

# --- Web entry point -------------------------------------------------------------
# nginx (frontend) is published on HTTP_BIND:HTTP_PORT (plain HTTP).
#  * COMPOSE_PROFILES=tls    -> HTTP_BIND=127.0.0.1 (only Caddy is public)
#  * COMPOSE_PROFILES=tunnel -> HTTP_BIND=127.0.0.1 (cloudflared uses the compose network)
#  * external TLS proxy/LB or a cloudflared in another VM/LXC
#                            -> HTTP_BIND=<this VM's LAN IP>, firewalled to that proxy
HTTP_BIND=127.0.0.1
HTTP_PORT=3080
# Address Caddy binds ports 80/443 on (profile tls).
TLS_BIND=0.0.0.0

# --- Cloudflare Tunnel (profile tunnel) ------------------------------------------------
# Token of a REMOTELY-MANAGED tunnel: Cloudflare Zero Trust -> Networks ->
# Tunnels -> Create -> Cloudflared, copy the value after "--token" (starts with
# eyJ). Public hostnames, in this order (docs/PROXMOX_INSTALL.md section 20):
#   cloud.nevatal.id -> http://frontend:8080
#   *.nevatal.id     -> http://edge:8088      (profile edge)
# Required when COMPOSE_PROFILES contains "tunnel". Keep .env at chmod 600.
CLOUDFLARE_TUNNEL_TOKEN=
# Host loopback port for cloudflared's /metrics and /ready (default 20241).
# CLOUDFLARED_METRICS_PORT=20241
# CLOUDFLARED_LOGLEVEL=info
# Pinned cloudflared image tag (also in deploy/k8s/addons/cloudflared).
# CLOUDFLARED_VERSION=2026.10.7

# --- Railway-style subdomains: https://<name>.PUBLIC_DOMAIN_ROOT ---------------------
# Users publish a port of their VM at https://<name>.PUBLIC_DOMAIN_ROOT. The
# "edge" proxy (profile edge) routes each name to the VM's private IP:port.
# Guide and security notes: docs/PROXMOX_INSTALL.md section 20.
#
# Empty = feature off. Strongly recommended: a SEPARATE registrable domain for
# tenant apps (e.g. nevatal.app), not the control plane's domain: tenant apps
# on *.nevatal.id are same-site with cloud.nevatal.id, and one phishing report
# against a tenant app can get the whole domain blocklisted.
# First-level names only (Cloudflare Universal SSL covers *.domain, not
# *.sub.domain).
PUBLIC_DOMAIN_ROOT=
# Names nobody may claim, in addition to the built-in list (comma-separated
# labels). Built in: www, cloud, api, app, admin, demo, docs, status, mail,
# auth, login, billing, edge, tunnel, proxmox and ~70 more, plus the control
# plane's own name (cloud in APP_BASE_URL=https://cloud.nevatal.id).
# Add EVERY other name that has its own DNS record in Cloudflare (e.g. vpn is
# built in, but "office" or "nas" are not): an explicit record wins over the
# wildcard, so a claimed name with its own record never reaches the edge.
RESERVED_SUBDOMAINS=
# Names one user may hold.
MAX_DOMAINS_PER_USER=5
# Days a released name stays blocked before anyone else can claim it.
DOMAIN_QUARANTINE_DAYS=14
# REQUIRED when PUBLIC_DOMAIN_ROOT is set: the customer VM subnet(s) the edge
# may connect to, comma-separated CIDRs (e.g. 10.20.0.0/24). VM addresses come
# from the guest agent, which the customer controls: the edge refuses any
# target outside these ranges.
EDGE_TARGET_CIDRS=
# Addresses the edge never connects to, even inside EDGE_TARGET_CIDRS
# (comma-separated): the Proxmox host, the gateway(s), this control-plane VM,
# DB/NFS/LB VMs, e.g. 10.20.0.1,10.0.0.2,10.0.0.50
EDGE_DENY_IPS=
# Only with deploy/compose/edge-publish.yml in COMPOSE_FILE (cloudflared or a
# proxy outside this stack reaches the edge on EDGE_BIND:EDGE_PORT_HOST):
# EDGE_BIND=127.0.0.1
# EDGE_PORT_HOST=8088

# --- Scaling ------------------------------------------------------------------------
# API replicas behind the frontend nginx (least_conn). All replicas share the
# storagedata volume on this host.
BACKEND_REPLICAS=2
# Per-replica PostgreSQL pool (backend defaults 15 / 5). Keep
# BACKEND_REPLICAS x DB_MAX_OPEN_CONNS below max_connections (100).
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=

# --- Secrets ------------------------------------------------------------------------
# openssl rand -hex 32   (>= 32 characters)
JWT_SECRET=CHANGE_ME
# openssl rand -hex 32. Only applied when the pgdata volume is FIRST created;
# changing it later requires ALTER ROLE inside PostgreSQL as well.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_USER=nevatal
POSTGRES_DB=nevatal_cloud

# --- Bootstrap administrator (required) -----------------------------------------------
# Created on first start. Password >= 12 characters, not a demo password.
# e.g. openssl rand -hex 16
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME

# --- Proxmox VE (Dell PowerEdge R640) -------------------------------------------------
# false = manage the real hypervisor below. true = simulated (dry run only!).
PROXMOX_MOCK=false
# IP or hostname of the Proxmox node (API on PROXMOX_PORT).
PROXMOX_HOST=CHANGE_ME
PROXMOX_PORT=8006
# USER@REALM!TOKENID, e.g. nevatal@pve!control-plane (see docs/PROXMOX_INSTALL.md)
PROXMOX_TOKEN_ID=CHANGE_ME
PROXMOX_TOKEN_SECRET=CHANGE_ME
# Node name as shown in the Proxmox tree (hostname of the R640).
PROXMOX_NODE_NAME=pve-dell-r640
# Storage for cloned VM disks (e.g. local-zfs, local-lvm).
PROXMOX_STORAGE=local-zfs
# true once Proxmox serves a certificate this host trusts.
PROXMOX_VERIFY_TLS=false

# --- Optional integrations ------------------------------------------------------------
# OpenRouter AI assistant: https://openrouter.ai/keys (empty = local fallback mode)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# WordPress bridge. Empty = disabled. Generate with: openssl rand -hex 32
# (the old public default key is rejected in production)
WORDPRESS_API_KEY=
WORDPRESS_URL=
# OAuth apps (optional; social login buttons are demo-only for now)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Topology B only (deploy/compose/multi-vm.yml) ------------------------------------
# Shared PostgreSQL VM and NFS export for object storage.
# EXTERNAL_DATABASE_URL=postgres://nevatal:<password>@10.0.0.20:5432/nevatal_cloud?sslmode=disable
# NFS_SERVER=10.0.0.21
# NFS_EXPORT=/srv/nevatal/storage

# --- Images ---------------------------------------------------------------------------
# Built locally by ./deploy.sh. To run prebuilt images instead, set these and
# run ./deploy.sh --no-build after `docker compose pull backend frontend`.
# BACKEND_IMAGE=ghcr.io/thirza258/nevatal-cloud-backend
# FRONTEND_IMAGE=ghcr.io/thirza258/nevatal-cloud-frontend
# IMAGE_TAG=latest
