# Production overlay secrets. Copy to secrets.env (gitignored) and fill in:
#   cp secrets.env.example secrets.env && chmod 600 secrets.env
# Hex values only (openssl rand -hex 32): POSTGRES_PASSWORD is embedded in
# DATABASE_URL and "$" or "#" would break parsing.
POSTGRES_USER=nevatal
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Bootstrap administrator (password >= 12 characters, not a demo password)
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME
# Proxmox API token: USER@REALM!TOKENID and its secret (docs/PROXMOX_INSTALL.md)
PROXMOX_TOKEN_ID=nevatal@pve!control-plane
PROXMOX_TOKEN_SECRET=CHANGE_ME
# Optional integrations (empty = disabled)
WORDPRESS_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
