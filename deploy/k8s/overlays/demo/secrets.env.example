# Demo overlay secrets. Copy to secrets.env (gitignored) and fill in:
#   cp secrets.env.example secrets.env
# Hex values only (openssl rand -hex 32): they are embedded in DATABASE_URL.
POSTGRES_USER=nevatal
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Optional. Visitors of a public demo can spend this key: use a capped key.
OPENROUTER_API_KEY=
