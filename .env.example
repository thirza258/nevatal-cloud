# =============================================================================
# Nevatal Cloud - LOCAL DEVELOPMENT environment
#
#   cp .env.example .env
#   docker compose up -d --build          # http://localhost:3080
#
# DEV-ONLY VALUES. Everything here is public and insecure on purpose: the
# simulated hypervisor (PROXMOX_MOCK=true) and the public demo accounts
# (admin@nevatal.id / AdminPass123!, demo@nevatal.id / DemoPass123!).
# Never put this file on a server reachable from a network you do not trust.
#
# Servers use one of these instead (see docs/PROXMOX_INSTALL.md):
#   cp deploy/env/demo.env.example .env        && ./deploy.sh --mode demo
#   cp deploy/env/production.env.example .env  && ./deploy.sh --mode production
#
# Docker Compose reads this file for ${VAR} interpolation: avoid "$" in values
# (or wrap the value in single quotes).
# =============================================================================

NEVATAL_MODE=development

# --- Application --------------------------------------------------------------
APP_ENV=development
DEMO_MODE=true
APP_BASE_URL=http://localhost:3080
# Empty = the backend's built-in development secret (development only).
JWT_SECRET=
TZ=UTC
# Optional (empty = backend defaults): CORS origins (development reflects any
# origin), proxy CIDRs trusted for X-Forwarded-For, Secure cookies, an extra
# admin account, per-replica DB pool size.
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
COOKIE_SECURE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=

# --- Published ports (development) ---------------------------------------------
# Web UI. Set HTTP_BIND=0.0.0.0 to reach it from other machines on your LAN.
HTTP_BIND=127.0.0.1
HTTP_PORT=3080
# Loopback-only ports for host tools (psql, go run, API clients).
BACKEND_HOST_PORT=8090
POSTGRES_HOST_PORT=5435
# Keep 1 while BACKEND_HOST_PORT is published (a fixed host port cannot be
# shared by several replicas).
BACKEND_REPLICAS=1

# --- PostgreSQL (bundled container) --------------------------------------------
# DEV-ONLY credentials (match the old default so existing dev volumes keep
# working). Only applied when the pgdata volume is created for the first time.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=nevatal_cloud
# Running the API on the host instead (cd backend && go run ./cmd/api)?
# export DATABASE_URL=postgres://postgres:postgrespassword@localhost:5435/nevatal_cloud?sslmode=disable

# --- Proxmox VE (Dell PowerEdge R640) ------------------------------------------
# true = simulated hypervisor. DEMO_MODE=true always forces true.
PROXMOX_MOCK=true
PROXMOX_HOST=
PROXMOX_PORT=8006
# Format: USER@REALM!TOKENID (Datacenter -> Permissions -> API Tokens)
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE_NAME=pve-dell-r640
PROXMOX_STORAGE=local-zfs
PROXMOX_VERIFY_TLS=false

# --- Integrations (optional) ---------------------------------------------------
# OpenRouter AI assistant: https://openrouter.ai/keys (empty = local fallback mode)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# WordPress bridge (empty in development = bundled plugin's legacy dev key)
WORDPRESS_API_KEY=
WORDPRESS_URL=
# OAuth apps (social login is mocked in demo/development mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Railway-style subdomains (https://<name>.PUBLIC_DOMAIN_ROOT) -----------------
# Empty = feature off. DEMO_MODE=true (the default above) always turns it off:
# to try it locally set DEMO_MODE=false, ADMIN_EMAIL/ADMIN_PASSWORD, e.g.
# PUBLIC_DOMAIN_ROOT=localtest.me (resolves to 127.0.0.1), enable the edge with
# COMPOSE_PROFILES=edge and publish it on loopback by appending
# deploy/compose/edge-publish.yml (COMPOSE_FILE=docker-compose.yml:deploy/compose/edge-publish.yml,
# EDGE_PORT_HOST=8088), then: curl -H 'Host: myapp.localtest.me' http://127.0.0.1:8088/
# Production settings and their meaning: deploy/env/production.env.example.
PUBLIC_DOMAIN_ROOT=
RESERVED_SUBDOMAINS=
MAX_DOMAINS_PER_USER=5
DOMAIN_QUARANTINE_DAYS=14
EDGE_TARGET_CIDRS=
EDGE_DENY_IPS=
# EDGE_BIND=127.0.0.1
# EDGE_PORT_HOST=8088
# AdControl snippet injected by the edge into customer HTML pages. The public
# site key comes from the AdControl dashboard; empty disables injection. The
# AdControl site must allow the hostnames under PUBLIC_DOMAIN_ROOT (for
# example *.nevatal.app). See docs/EDGE_ADS.md.
ADCONTROL_SDK_URL=https://marketing.nevatal.id/sdk/v1/adcontrol.js
ADCONTROL_SITE_KEY=
ADCONTROL_PLACEMENT_KEY=edge-banner

# --- Optional services ----------------------------------------------------------
# Comma-separated: redis, edge (subdomain proxy), tunnel (cloudflared, needs
# CLOUDFLARE_TUNNEL_TOKEN). Redis is not used by the application yet.
# COMPOSE_PROFILES=redis
REDIS_HOST_PORT=6385
CLOUDFLARE_TUNNEL_TOKEN=
