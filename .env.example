# Nevatal Cloud Environment Configuration
# PRD Reference Section 25.4

# Application
APP_ENV=development
PORT=8090
APP_BASE_URL=http://localhost:3080
JWT_SECRET=nevatal-cloud-super-secret-key-production-ready-32-chars

# Database & Cache
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5435/nevatal_cloud?sslmode=disable
REDIS_URL=localhost:6385

# Proxmox VE Hypervisor Integration (Dell PowerEdge R640)
# Set PROXMOX_MOCK=false to connect to a live Proxmox server
PROXMOX_MOCK=true
PROXMOX_HOST=192.168.1.100
PROXMOX_PORT=8006
PROXMOX_NODE_NAME=pve-dell-r640
PROXMOX_STORAGE=local-zfs
PROXMOX_VERIFY_TLS=false

# Proxmox VE API Token Credentials
# Created under Datacenter -> Permissions -> API Tokens
# Format: USER@REALM!TOKENID
PROXMOX_TOKEN_ID=nevatal-cloud@pve!api-token
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# OpenRouter AI Assistant Integration (Container Provisioning & Support)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

